# ----------------------------------------------------------------------------
# VERCEL DEPLOYMENT ENVIRONMENT VARIABLES
# Add these in Vercel Project Settings -> Environment Variables
# ----------------------------------------------------------------------------

# 1. MongoDB Atlas Connection URI (REQUIRED)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://admin:yourpassword@cluster0.mongodb.net/reflect_ai?retryWrites=true&w=majority"

# 2. JWT Secret Key for Session Authentication (REQUIRED)
JWT_SECRET="ai-weekly-goal-tracker-secret-key-super-secure-2026"

# NOTE: DO NOT ADD 'NODE_ENV' IN VERCEL! (Next.js automatically sets it to production)

# 4. Optional: Public App URL (e.g. https://your-project.vercel.app)
NEXT_PUBLIC_APP_URL=""

# 5. Optional: AI Provider API Keys (Leave blank to use built-in heuristic scoring engine)
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
